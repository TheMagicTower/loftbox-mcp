# /etc/loftbox-mcp/oauth.env — 브라우저 OAuth 브로커 설정 예시(플레이스홀더).
# 실제 비밀을 이 예시 파일에 적지 마세요. VPS 에 0600(서비스 사용자 소유)으로
# 배치하고, 값은 운영자가 별도 주입합니다. deploy/DEPLOY.md 참고.
#
# 별도 운영 승인 후 전용 디렉터리와 파일을 준비합니다.
# 현재 tracked 유닛은 User= 지정이 없어 root 로 실행합니다. 실제 서비스
# 사용자에 맞춰 디렉터리 0700·파일 0600 소유권을 설정하세요.
# 기존 파일을 덮어쓰거나 새 OS 사용자를 만드는 예제가 아닙니다.
# 실제 비밀은 승인된 비밀 관리 경로로 주입하고 로그·채팅·셸 기록에
# 출력하지 마세요. source 디렉터리 밖에 env 와 store 를 보존합니다.

# 브로커 활성화. true 가 아니면 아래 값과 무관하게 비활성(레거시 유지).
LOFTBOX_MCP_OAUTH_ENABLED=true
# 신뢰 공개 origin — 반드시 https 절대 origin.
LOFTBOX_MCP_PUBLIC_URL=https://mcp.loftbox.net
# 승인된 경로로 생성·주입하는 32바이트 base64 서버 암호화 비밀.
# 교체·분실 시 기존 승인은 복호화 불가(재승인 필요).
LOFTBOX_MCP_OAUTH_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_SECRET
# durable 저장소 절대 경로. /opt/loftbox-mcp 밖(배포 시 삭제 대상),
# 전용 0700 디렉터리(서비스 사용자 소유) 안에 둡니다.
LOFTBOX_MCP_OAUTH_STORE=/var/lib/loftbox-mcp/oauth-store.json
